{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 2},
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "tenantId": {"type": "string", "minLength": 1},
        "clientId": {"type": "string", "minLength": 1},
        "allowedClientIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "resourceUrl": {"type": "string", "pattern": "^https://[^\\s/?#]+/[^\\s?#]*[^\\s/?#]$"},
        "extraAllowedHosts": {"type": "array", "items": {"type": "string"}},
        "allowedOrigins": {"type": "array", "items": {"type": "string"}},
        "httpTimeoutSeconds": {"type": "number", "minimum": 1, "maximum": 120},
        "oboCacheEntries": {"type": "integer", "minimum": 1, "maximum": 4096},
        "oboMaxConcurrentExchanges": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "credentials": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "clientSecretKey": {"type": "string", "minLength": 1}
      }
    },
    "enterpriseCA": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "configMapName": {"type": "string"},
        "secretName": {"type": "string"},
        "key": {"type": "string", "pattern": "^[a-zA-Z0-9_.-]+$"}
      }
    },
    "service": {
      "type": "object",
      "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "transportSecurity": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["tls", "mesh"]},
        "existingSecret": {"type": "string"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressFrom": {"type": "array", "items": {"type": "object"}}
      }
    },
    "topology": {
      "type": "object",
      "properties": {
        "nodeSpread": {"type": "boolean"},
        "zoneSpread": {"type": "boolean"},
        "zoneWhenUnsatisfiable": {"enum": ["ScheduleAnyway", "DoNotSchedule"]},
        "zoneMinDomains": {"type": "integer", "minimum": 2},
        "minDomains": {"type": "integer", "minimum": 2}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "maxUnavailable": {"type": "integer", "minimum": 0}
      }
    }
  }
}
