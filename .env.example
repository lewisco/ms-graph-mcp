# Example values only. Copy to .env for local development and replace each value.
# In Kubernetes, supply the secret from your secret manager instead of this file.
GRAPH_MCP_TENANT_ID=11111111-1111-4111-8111-111111111111
GRAPH_MCP_CLIENT_ID=22222222-2222-4222-8222-222222222222
GRAPH_MCP_CLIENT_SECRET=replace-with-mcp-api-secret
GRAPH_MCP_ALLOWED_CLIENT_IDS=["33333333-3333-4333-8333-333333333333"]
GRAPH_MCP_RESOURCE_URL=https://litellm.example.com/msgraph/mcp
GRAPH_MCP_SCOPE_NAME=access_as_user
# Include the Host header LiteLLM sends to the internal MCP service.
GRAPH_MCP_ALLOWED_HOSTS=["127.0.0.1:8000","ms-graph-mcp:8000"]
# Server-to-server callers normally omit Origin. If sent, allow its exact HTTPS origin.
GRAPH_MCP_ALLOWED_ORIGINS=[]
GRAPH_MCP_HTTP_TIMEOUT_SECONDS=15
GRAPH_MCP_OBO_CACHE_ENTRIES=128
# Optional PEM containing additional enterprise CA certificates; public roots are retained.
# GRAPH_MCP_EXTRA_CA_FILE=/etc/ms-graph-mcp/ca/enterprise-ca.pem
